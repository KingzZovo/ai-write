# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aiwrite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiwrite

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# LLM API Keys (configure at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenAI Compatible Endpoint (optional, for third-party or local models)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Chapter evaluation: one total deadline includes lookup, retries and fallback.
# Manual, SSE and background callers share this budget (seconds).
EVALUATION_TOTAL_TIMEOUT_SECONDS=180
# Per-request ceiling, clamped to the remaining total by cancellation.
EVALUATION_REQUEST_TIMEOUT=120

# Application
SECRET_KEY=change-this-to-a-random-secret-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth
AUTH_USERNAME=king
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=
DISABLE_AUTH=0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3100,http://localhost:8080

# Emergency template planning is disabled by default; failed model plans remain errors.
ALLOW_SCENE_PLANNER_FALLBACK=false
